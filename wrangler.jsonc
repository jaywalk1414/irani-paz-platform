{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "irani-paz-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
    "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "938a1bd5d8ad4ed1942bcc9e9b8f94da",
      "localConnectionString": "postgresql://user:pass@localhost:5432/placeholder"
    }
  ]
}