{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "restaurant-saas",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-05",
"compatibility_flags": [
  "nodejs_compat",
  "nodejs_compat_populate_process_env"
],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}